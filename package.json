{
  "name": "obsidian-hemingway",
  "version": "1.0.0",
  "description": "Hemingway-style readability highlights, live inside Obsidian notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "esbuild test/analyzer.test.mts --bundle --platform=node --format=esm --outfile=test/.out.mjs --log-level=error && node test/.out.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "obsidian": "1.14.4",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "writing",
    "readability",
    "hemingway"
  ],
  "author": "dhruvir-zala",
  "repository": {
    "type": "git",
    "url": "https://github.com/dhruvir-zala/hemingway-for-obsidian.git"
  },
  "bugs": {
    "url": "https://github.com/dhruvir-zala/hemingway-for-obsidian/issues"
  }
}
